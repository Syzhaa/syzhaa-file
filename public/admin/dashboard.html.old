<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Syzhaa File</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        .brutal-border { border: 3px solid #0f172a; }
        .brutal-shadow { box-shadow: 6px 6px 0px #0f172a; }
        .brutal-border-thin { border: 2px solid #0f172a; }
    </style>
</head>
<body class="min-h-screen bg-slate-50">
    <!-- Loading State -->
    <div id="loading" class="fixed inset-0 bg-slate-900/50 flex items-center justify-center z-50">
        <div class="bg-white brutal-border brutal-shadow p-8 rounded-lg">
            <div class="animate-spin h-12 w-12 border-4 border-slate-900 border-t-transparent rounded-full mx-auto"></div>
            <p class="mt-4 text-slate-900 font-semibold">Loading...</p>
        </div>
    </div>

    <!-- Main Content -->
    <div id="app" class="hidden">
        <!-- Header -->
        <header class="bg-white brutal-border-thin border-b sticky top-0 z-40">
            <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <h1 class="text-2xl font-bold text-slate-900">Syzhaa File Admin</h1>
                    <a href="/" class="text-sm text-slate-600 hover:text-slate-900">← Public Site</a>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-3">
                        <img id="userAvatar" class="w-10 h-10 rounded-full brutal-border-thin" src="" alt="Avatar">
                        <div>
                            <p id="userName" class="font-semibold text-slate-900"></p>
                            <p id="userEmail" class="text-xs text-slate-600"></p>
                        </div>
                    </div>
                    <button onclick="logout()" class="px-4 py-2 bg-red-500 text-white font-semibold rounded brutal-border-thin hover:bg-red-600">
                        Logout
                    </button>
                </div>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 py-8">
            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="bg-white brutal-border brutal-shadow p-6 rounded-lg">
                    <p class="text-slate-600 text-sm font-semibold mb-1">Total Rooms</p>
                    <p id="statTotalRooms" class="text-3xl font-bold text-slate-900">-</p>
                </div>
                <div class="bg-white brutal-border brutal-shadow p-6 rounded-lg">
                    <p class="text-slate-600 text-sm font-semibold mb-1">Active Rooms</p>
                    <p id="statActiveRooms" class="text-3xl font-bold text-green-600">-</p>
                </div>
                <div class="bg-white brutal-border brutal-shadow p-6 rounded-lg">
                    <p class="text-slate-600 text-sm font-semibold mb-1">Total Files</p>
                    <p id="statTotalFiles" class="text-3xl font-bold text-slate-900">-</p>
                </div>
                <div class="bg-white brutal-border brutal-shadow p-6 rounded-lg">
                    <p class="text-slate-600 text-sm font-semibold mb-1">Storage Used</p>
                    <p id="statTotalSize" class="text-3xl font-bold text-blue-600">-</p>
                </div>
            </div>

            <!-- API Keys Section -->
            <div class="bg-white brutal-border brutal-shadow rounded-lg p-6 mb-8">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-slate-900">API Keys</h2>
                    <button onclick="showCreateKeyModal()" class="px-4 py-2 bg-slate-900 text-white font-semibold rounded brutal-border-thin hover:bg-slate-800">
                        + Create API Key
                    </button>
                </div>

                <div id="apiKeysList" class="space-y-4">
                    <!-- Populated by JS -->
                </div>
            </div>

            <!-- API Documentation Quick Links -->
            <div class="bg-slate-100 brutal-border rounded-lg p-6">
                <h3 class="font-bold text-slate-900 mb-4">Quick API Reference</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div>
                        <p class="font-semibold text-slate-900 mb-2">Create Room:</p>
                        <code class="block bg-white p-3 rounded brutal-border-thin text-xs font-mono">
POST /api/v1/room/create<br>
Authorization: Bearer sfa_xxx<br>
{"expiry_minutes": 120}
                        </code>
                    </div>
                    <div>
                        <p class="font-semibold text-slate-900 mb-2">Get Room Link:</p>
                        <code class="block bg-white p-3 rounded brutal-border-thin text-xs font-mono">
GET /api/v1/room/{id}/link<br>
Authorization: Bearer sfa_xxx
                        </code>
                    </div>
                    <div>
                        <p class="font-semibold text-slate-900 mb-2">List Files:</p>
                        <code class="block bg-white p-3 rounded brutal-border-thin text-xs font-mono">
GET /api/v1/room/{id}/files<br>
Authorization: Bearer sfa_xxx
                        </code>
                    </div>
                    <div>
                        <p class="font-semibold text-slate-900 mb-2">Download All (ZIP):</p>
                        <code class="block bg-white p-3 rounded brutal-border-thin text-xs font-mono">
GET /api/v1/room/{id}/download-all<br>
Authorization: Bearer sfa_xxx
                        </code>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Create API Key Modal -->
    <div id="createKeyModal" class="hidden fixed inset-0 bg-slate-900/50 flex items-center justify-center z-50 p-4">
        <div class="bg-white brutal-border brutal-shadow rounded-lg p-6 max-w-md w-full">
            <h3 class="text-xl font-bold text-slate-900 mb-4">Create New API Key</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-900 mb-2">Key Name</label>
                    <input id="keyName" type="text" class="w-full px-4 py-2 brutal-border-thin rounded" placeholder="e.g., Production API">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-900 mb-2">Expiry (days)</label>
                    <input id="keyExpiry" type="number" class="w-full px-4 py-2 brutal-border-thin rounded" placeholder="Leave empty for no expiry">
                    <p class="text-xs text-slate-600 mt-1">Kosongkan untuk permanent key</p>
                </div>
                <div class="flex gap-3">
                    <button onclick="createAPIKey()" class="flex-1 px-4 py-2 bg-slate-900 text-white font-semibold rounded brutal-border-thin hover:bg-slate-800">
                        Create
                    </button>
                    <button onclick="hideCreateKeyModal()" class="flex-1 px-4 py-2 bg-slate-200 text-slate-900 font-semibold rounded brutal-border-thin hover:bg-slate-300">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Show API Key Modal (one-time display) -->
    <div id="showKeyModal" class="hidden fixed inset-0 bg-slate-900/50 flex items-center justify-center z-50 p-4">
        <div class="bg-white brutal-border brutal-shadow rounded-lg p-6 max-w-lg w-full">
            <h3 class="text-xl font-bold text-slate-900 mb-4">⚠️ Save Your API Key</h3>
            <p class="text-sm text-slate-600 mb-4">Copy API key ini sekarang. Kamu tidak akan bisa melihatnya lagi!</p>
            <div class="bg-slate-100 brutal-border-thin rounded p-4 mb-4">
                <code id="newAPIKey" class="block font-mono text-sm break-all select-all"></code>
            </div>
            <button onclick="copyAndCloseKeyModal()" class="w-full px-4 py-2 bg-slate-900 text-white font-semibold rounded brutal-border-thin hover:bg-slate-800">
                Copy & Close
            </button>
        </div>
    </div>

    <script src="/admin/dashboard.js"></script>
</body>
</html>
